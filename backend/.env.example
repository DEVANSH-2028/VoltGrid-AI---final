PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-in-production"

# SAP Generative AI Hub
LLM_PROVIDER="sap-genai-hub"
SAP_GENAI_MODEL="gemini-3.5-flash"
SAP_GENAI_RESOURCE_GROUP=""
AICORE_SERVICE_KEY=""

# SAP extension gateway: auto uses live endpoints when configured, otherwise local seed data
SAP_MODE="auto"
SAP_TIMEOUT_MS=2500
SAP_API_HUB_KEY=""
SAP_S4HANA_BASE_URL=""
SAP_S4HANA_TOKEN=""
SAP_ARIBA_BASE_URL=""
SAP_ARIBA_TOKEN=""
SAP_IBP_BASE_URL=""
SAP_IBP_TOKEN=""
SAP_BUILD_WEBHOOK_URL=""
SAP_BUILD_TOKEN=""

# Live S/4HANA purchase-order writes are opt-in and require all four master-data mappings
SAP_ALLOW_LIVE_WRITE="false"
SAP_S4HANA_COMPANY_CODE=""
SAP_S4HANA_PURCHASING_ORG=""
SAP_S4HANA_PURCHASING_GROUP=""
SAP_S4HANA_PLANT=""
SAP_S4HANA_CURRENCY="INR"
