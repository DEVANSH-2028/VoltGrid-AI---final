{
  "name": "voltgrid-ai",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "npm install && npm run prisma:generate --workspace=backend",
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run prisma:generate --workspace=backend && npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "db:setup": "npm run db:migrate:deploy --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:import:sqlite": "node backend/scripts/import-sqlite-to-neon.js",
    "db:seed:demo": "npm run db:seed:demo --workspace=backend"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  }
}
